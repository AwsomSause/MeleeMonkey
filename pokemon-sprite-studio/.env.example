# PSAS backend settings. Copy to .env for local development.
# API KEYS DO NOT GO HERE. They are stored in Windows Credential Manager via
# Settings > Providers in the app (or `python -m backend.core.secrets set <provider>`).

PSAS_LOG_LEVEL=INFO
PSAS_DATA_DIR=            # default: %APPDATA%\PSAS
PSAS_ALLOW_LIVE_TESTS=0   # 1 = allow tests marked @live to spend money
PSAS_DIRECTOR_MODEL=claude-sonnet-5-5   # AI Director model; configurable in Settings
PSAS_ASEPRITE_PATH=       # optional; enables .aseprite export (see DECISIONS D002)
